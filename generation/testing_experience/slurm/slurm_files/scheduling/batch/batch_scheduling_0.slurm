#!/bin/bash
#SBATCH --job-name=batch_scheduling_0
#SBATCH --output=/home/sonia/Bureau/Codethesis/generation/testing_experience/slurm/output/scheduling/output_batch_scheduling_0.txt
#SBATCH --ntasks=1
#SBATCH --time=00:30:00
#SBATCH --mem=2G

for config_key in scheduling_generate_1_c4 scheduling_generate_2_c4 scheduling_generate_3_c4 scheduling_generate_4_c4 scheduling_generate_5_c4 scheduling_generate_6_c4 scheduling_generate_7_c4 scheduling_generate_8_c4 scheduling_generate_9_c4 scheduling_generate_10_c4 scheduling_generate_11_c4 scheduling_generate_12_c4 scheduling_generate_13_c4 scheduling_generate_14_c4 scheduling_generate_15_c4 scheduling_generate_16_c4 scheduling_generate_17_c4 scheduling_generate_18_c4 scheduling_generate_19_c4 scheduling_generate_20_c4 scheduling_generate_21_c4 scheduling_generate_22_c4 scheduling_generate_23_c4 scheduling_generate_24_c4 scheduling_generate_25_c4 scheduling_generate_26_c4 scheduling_generate_27_c4 scheduling_generate_28_c4 scheduling_generate_29_c4 scheduling_generate_30_c4 scheduling_generate_31_c4 scheduling_generate_32_c4 scheduling_generate_33_c4 scheduling_generate_34_c4 scheduling_generate_35_c4 scheduling_generate_36_c4 scheduling_generate_37_c4 scheduling_generate_38_c4 scheduling_generate_39_c4 scheduling_generate_40_c4 scheduling_generate_41_c4 scheduling_generate_42_c4 scheduling_generate_43_c4 scheduling_generate_44_c4 scheduling_generate_45_c4 scheduling_generate_46_c4 scheduling_generate_47_c4 scheduling_generate_48_c4 scheduling_generate_49_c4 scheduling_generate_50_c4 scheduling_generate_51_c4 scheduling_generate_52_c4 scheduling_generate_53_c4 scheduling_generate_54_c4 scheduling_generate_55_c4 scheduling_generate_56_c4 scheduling_generate_57_c4 scheduling_generate_58_c4 scheduling_generate_59_c4 scheduling_generate_60_c4 scheduling_generate_61_c4 scheduling_generate_62_c4 scheduling_generate_63_c4 scheduling_generate_64_c4 scheduling_generate_65_c4 scheduling_generate_66_c4 scheduling_generate_67_c4 scheduling_generate_68_c4 scheduling_generate_69_c4 scheduling_generate_70_c4 scheduling_generate_71_c4 scheduling_generate_72_c4 scheduling_generate_73_c4 scheduling_generate_74_c4 scheduling_generate_75_c4 scheduling_generate_76_c4 scheduling_generate_77_c4 scheduling_generate_78_c4 scheduling_generate_79_c4 scheduling_generate_80_c4 scheduling_generate_81_c4 scheduling_generate_82_c4 scheduling_generate_83_c4 scheduling_generate_84_c4 scheduling_generate_85_c4 scheduling_generate_86_c4 scheduling_generate_87_c4 scheduling_generate_88_c4 scheduling_generate_89_c4 scheduling_generate_90_c4 scheduling_generate_91_c4 scheduling_generate_92_c4 scheduling_generate_93_c4 scheduling_generate_94_c4 scheduling_generate_95_c4 scheduling_generate_96_c4 scheduling_generate_97_c4 scheduling_generate_98_c4 scheduling_generate_99_c4 scheduling_generate_100_c4; do  # Séparer par des espaces
