# Attendre que tous les jobs soient terminés
while [ $(squeue -u $USER -h -t RUNNING,PENDING -o "%A %j" | grep 'scheduling' | grep -v 'batch_scheduling'| grep -v 'all_schedulings_master' | wc -l) -gt 0 ]; do
  sleep 1
done

                    